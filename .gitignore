# Build output
/dist/

# Per-fork content — copy data.template.json to create this
/data.json

# Per-fork assets — personal images/downloads, keep only the folder structure (see docs/arch/0013)
/assets/*
!/assets/.gitkeep
!/assets/download/
/assets/download/*
!/assets/download/.gitkeep
# App-owned assets the site itself depends on — tracked, not per-fork (see docs/arch/0017)
!/assets/core-assets/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.ruff_cache/
.pytest_cache/

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# For stuff I want to hide
hidden/
